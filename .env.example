# Supabase (vista snapshot_data + imágenes)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alternativa en Supabase Docker (cuando SUPABASE_PUBLISHABLE_KEY está vacío):
# VITE_SUPABASE_ANON_KEY=eyJ...
# Bucket público de imágenes (full + thumb por id)
VITE_SUPABASE_STORAGE_BUCKET=imageStore
