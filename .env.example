# Conector de persistencia (registrado en src/config/database.config.ts)
# supabase = adaptador database/supabase (por defecto)
# remote   = HTTP contra backend (sin conector de base de datos)
VITE_DATABASE_API=supabase

# Base URL del backend (solo remote)
VITE_API_BASE_URL=/api

# Proxy de Vite en desarrollo (solo npm run dev)
VITE_API_PROXY_TARGET=http://localhost:3000

# Motor Supabase (VITE_DATABASE_API=supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alternativa en Supabase Docker (cuando SUPABASE_PUBLISHABLE_KEY está vacío):
# VITE_SUPABASE_ANON_KEY=eyJ...
